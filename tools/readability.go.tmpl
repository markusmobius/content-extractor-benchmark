package main

import (
	"encoding/json"
	"fmt"
	"io"
	"net/url"
	"os"
	"strings"
	"time"

	readability "github.com/markusmobius/go-readabilityV2"
)

type request struct {
	ID       string `json:"id"`
	URL      string `json:"url"`
	HTMLPath string `json:"html_path"`
}

type metadata struct {
	Title    string   `json:"title"`
	Authors  []string `json:"authors"`
	Date     string   `json:"date"`
	Language string   `json:"language"`
}

type prediction struct {
	ID       string   `json:"id"`
	Text     string   `json:"text"`
	Comments string   `json:"comments"`
	Metadata metadata `json:"metadata"`
	Error    string   `json:"error,omitempty"`
}

func extract(input request) prediction {
	output := prediction{ID: input.ID}
	file, err := os.Open(input.HTMLPath)
	if err != nil {
		output.Error = err.Error()
		return output
	}
	defer file.Close()
	originalURL, _ := url.ParseRequestURI(input.URL)
	parser := readability.NewParser()
	article, err := parser.Parse(file, originalURL)
	if err != nil {
		output.Error = err.Error()
		return output
	}
	var text strings.Builder
	if err := article.RenderText(&text); err != nil {
		output.Error = err.Error()
		return output
	}
	output.Text = text.String()
	output.Metadata.Title = article.Title()
	output.Metadata.Language = article.Language()
	if byline := strings.TrimSpace(article.Byline()); byline != "" {
		output.Metadata.Authors = []string{byline}
	}
	if published, err := article.PublishedTime(); err == nil {
		output.Metadata.Date = published.Format("2006-01-02")
	}
	return output
}

func run() error {
	time.Local = time.UTC
	decoder := json.NewDecoder(os.Stdin)
	encoder := json.NewEncoder(os.Stdout)
	for {
		var input request
		if err := decoder.Decode(&input); err == io.EOF {
			return nil
		} else if err != nil {
			return err
		}
		if input.ID == "" || input.HTMLPath == "" {
			return fmt.Errorf("each input requires id and html_path")
		}
		if err := encoder.Encode(extract(input)); err != nil {
			return err
		}
	}
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
